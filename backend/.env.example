# Copy to .env for local development. Never commit .env.
RUNTIME=local
LOG_LEVEL=INFO
AWS_REGION=us-east-1
# Named profile from ~/.aws/config, including SSO profiles. Leave blank to use the default
# credential chain. Run `aws sso login --profile <name>` before starting the API.
AWS_PROFILE=
# Or, for an IAM user without SSO, static keys instead of a profile. A profile is preferred:
# an SSO session expires by itself, a key file does not. Never commit these.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional locally: leave blank to run without any AWS calls.
DATA_BUCKET=
COMPREHEND_ENABLED=false
BEDROCK_ENABLED=false
# Comprehend billing structure (units of 100 chars, 3-unit minimum). The price itself is fetched
# live from the AWS Price List API (needs AWS credentials + pricing:GetProducts) and cached 24h.
COMPREHEND_UNIT_CHARS=100
COMPREHEND_MIN_UNITS=3
PRICING_ENABLED=true
PRICING_CACHE_HOURS=24
# Additional stale allowance after the TTL. Both durations must be nonnegative.
PRICING_STALE_GRACE_HOURS=48

# Operator-only details in /health and the UI (checkpoint paths, enabled services).
# Defaults to on for RUNTIME=local and off in Lambda; set explicitly to override.
# DIAGNOSTICS=true

# Where stage snapshots (collected / processed / labelled CSVs) go when no DATA_BUCKET is set.
CHECKPOINT_DIR=data/checkpoints

# X API. Paste a bearer token from the account you want to use.
# To switch accounts, change this one line.
X_BEARER_TOKEN=
X_MAX_READS_PER_FETCH=1000
X_MAX_READS_PER_DAY=3000
X_COST_PER_READ_USD=0.005

# Operator secret exchanged at /auth/session for a temporary browser token; scripts can use X-API-Key.
# Leave blank locally; required for internet-facing deployments that can spend API credits.
API_KEY=

CORS_ORIGINS=http://localhost:5173

# History database (runs, X spend ledger). Default: SQLite in ./data. SQLite or postgresql+psycopg URLs are supported.
# Required for paid X collection in Lambda; every instance must use the same database.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/sentiment_prep
